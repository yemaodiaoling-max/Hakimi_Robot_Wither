[Unit]
Description=Hakimi Bilibili video and livestream watcher (video module)
After=network-online.target hakimi-gateway.service
Wants=hakimi-gateway.service

[Service]
Type=simple
WorkingDirectory=@VIDEO@
Environment=PYTHONPATH=@VIDEO@/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/python -m bili_companion.runtime.watcher --config @VIDEO@/deploy/watcher.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
